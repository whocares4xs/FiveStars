<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Get a Free Estimate | Five Stars Office Cleaning Service LLC</title>
<meta name="description" content="Request a free office cleaning estimate from Five Stars Office Cleaning Service LLC, serving Islip, Smithtown, Huntington, Babylon and adjacent Long Island communities.">
<link rel="icon" href="https://fivestarsocs.weebly.com/uploads/1/3/1/6/131625299/published/picturelogo.png?1593550711">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  :root{
    --pine:#1C2B3A;
    --pine-deep:#121D28;
    --ivory:#FFFFFF;
    --slate:#5E6B78;
    --gold:#6FB8E8;
    --line:#E4EBF0;
    --max:1120px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--ivory);
    color:var(--pine-deep);
    font-family:'Inter',sans-serif;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Sora',sans-serif;
    margin:0;
    color:var(--pine-deep);
    font-weight:600;
    letter-spacing:-0.01em;
  }
  a{color:inherit;}
  img{max-width:100%;display:block;}
  .wrap{max-width:var(--max);margin:0 auto;padding:0 24px;}

  /* Header */
  header{
    position:sticky;top:0;z-index:20;
    background:rgba(247,245,239,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex;align-items:center;justify-content:space-between;
    padding:14px 24px;max-width:var(--max);margin:0 auto;
  }
  .brand{display:flex;align-items:center;gap:12px;text-decoration:none;}
  .brand img{height:48px;width:auto;}
  .brand span{font-family:'Sora',sans-serif;font-size:1.05rem;color:var(--pine-deep);line-height:1.2;}
  .nav-links{display:flex;align-items:center;gap:28px;font-size:0.95rem;}
  .nav-links a{text-decoration:none;color:var(--pine-deep);}
  .nav-links a:hover{color:var(--gold);}
  .btn{
    display:inline-block;
    background:var(--pine);
    color:#fff;
    padding:12px 26px;
    border-radius:10px;
    text-decoration:none;
    font-weight:500;
    font-size:0.95rem;
    border:1px solid var(--pine);
    transition:background .2s ease, color .2s ease;
    cursor:pointer;
  }
  .btn:hover{background:var(--pine-deep);}
  .btn-gold{background:var(--gold);border-color:var(--gold);color:var(--pine-deep);}
  .btn-gold:hover{background:#b8913f;}

  @media (max-width:860px){
    .nav-links .nav-only{display:none;}
  }

  /* Page intro */
  .intro{
    padding:72px 0 48px;
    border-bottom:1px solid var(--line);
    background:linear-gradient(180deg, #F3F9FE 0%, #FFFFFF 60%);
  }
  .intro .wrap{max-width:720px;}
  .eyebrow-plain{color:var(--slate);font-size:0.95rem;margin-bottom:18px;}
  .intro h1{
    font-size:clamp(2rem, 4vw, 2.8rem);
    line-height:1.1;
  }
  .intro p.lede{
    margin-top:20px;
    font-size:1.1rem;
    color:var(--slate);
  }
  .intro .call-note{
    margin-top:18px;
    font-size:1rem;
    color:var(--pine-deep);
  }
  .intro .call-note a{
    color:var(--pine);
    font-weight:600;
    text-decoration:none;
  }
  .intro .call-note a:hover{text-decoration:underline;}

  /* Form section */
  .form-section{padding:56px 0 96px;}
  .form-section .wrap{max-width:720px;}

  form{
    background:#fff;
    border:1px solid var(--line);
    padding:40px;
    border-radius:20px;
    box-shadow:0 20px 48px rgba(28,43,58,0.06);
  }
  .form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
  }
  .field{margin-bottom:22px;}
  .field label{
    display:block;
    font-size:0.92rem;
    color:var(--pine-deep);
    margin-bottom:8px;
    font-weight:500;
  }
  .field label .req{color:var(--gold);}
  .field input,
  .field textarea{
    width:100%;
    padding:12px 14px;
    border:1px solid var(--line);
    background:var(--ivory);
    font-family:'Inter',sans-serif;
    font-size:1rem;
    color:var(--pine-deep);
    border-radius:10px;
  }
  .field input:focus,
  .field textarea:focus{
    outline:2px solid var(--pine);
    outline-offset:1px;
    background:#fff;
  }
  .field textarea{resize:vertical;min-height:120px;}
  .required-note{
    font-size:0.85rem;
    color:var(--slate);
    margin-bottom:28px;
  }
  .required-note .req{color:var(--gold);}

  .submit-row{
    display:flex;
    align-items:center;
    gap:18px;
    margin-top:8px;
    flex-wrap:wrap;
  }
  button.btn{
    font-size:1rem;
    padding:13px 32px;
    border:none;
  }
  .form-status{
    font-size:0.95rem;
    color:var(--slate);
  }
  .form-status.success{color:var(--pine);font-weight:500;}
  .form-status.error{color:#9B4034;font-weight:500;}

  @media (max-width:600px){
    .form-row{grid-template-columns:1fr;}
    form{padding:28px 22px;}
  }

  /* Footer */
  footer{
    background:var(--pine-deep);
    color:#CFE0D6;
    padding:40px 0 28px;
  }
  .footer-bottom{
    display:flex;justify-content:space-between;align-items:center;
    font-size:0.85rem;
    color:#7E9686;
    flex-wrap:wrap;
    gap:10px;
    max-width:var(--max);
    margin:0 auto;
    padding:0 24px;
  }
  .footer-bottom a{color:#CFE0D6;text-decoration:none;}
  .footer-bottom a:hover{color:var(--gold);}
</style>
</head>
<body>

<header>
  <div class="nav">
    <a class="brand" href="index.html">
      <img src="https://fivestarsocs.weebly.com/uploads/1/3/1/6/131625299/published/picturelogo.png?1593550711" alt="Five Stars Office Cleaning Service LLC logo">
      <span>Five Stars<br>Office Cleaning</span>
    </a>
    <nav class="nav-links">
      <a class="nav-only" href="index.html#about">About</a>
      <a class="nav-only" href="index.html#services">Services</a>
      <a class="nav-only" href="index.html#contact">Contact</a>
      <a class="btn" href="get-a-free-estimate-today.html">Get a Free Estimate</a>
    </nav>
  </div>
</header>

<main>

  <section class="intro">
    <div class="wrap">
      <p class="eyebrow-plain">Free, no-obligation estimate</p>
      <h1>Get a quote</h1>
      <p class="lede">We offer our services exclusively in New York, to the Central Long Island area including but not limited to the towns of Islip, Smithtown, Huntington and Babylon and adjacent communities. We'll eventually expand to other areas as our business grows.</p>
      <p class="lede">If your office is located within this area, feel free to reach out by filling out the form below and we'll get back to you as soon as possible.</p>
      <p class="call-note">Please submit your information below for a free estimate, or call us for immediate assistance at <a href="tel:6313344943">631-334-4943</a>.</p>
    </div>
  </section>

  <section class="form-section">
    <div class="wrap">
      <form id="estimate-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">

        <input type="hidden" name="_subject" value="New Free Estimate Request — Five Stars Office Cleaning">

        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;" aria-hidden="true">

        <p class="required-note"><span class="req">*</span> Indicates required field</p>

        <div class="form-row">
          <div class="field">
            <label for="first-name">First name <span class="req">*</span></label>
            <input type="text" id="first-name" name="First Name" required autocomplete="given-name">
          </div>
          <div class="field">
            <label for="last-name">Last name <span class="req">*</span></label>
            <input type="text" id="last-name" name="Last Name" required autocomplete="family-name">
          </div>
        </div>

        <div class="field">
          <label for="company">Company name <span class="req">*</span></label>
          <input type="text" id="company" name="Company Name" required autocomplete="organization">
        </div>

        <div class="form-row">
          <div class="field">
            <label for="email">Email <span class="req">*</span></label>
            <input type="email" id="email" name="Email" required autocomplete="email">
          </div>
          <div class="field">
            <label for="phone">Phone number <span class="req">*</span></label>
            <input type="tel" id="phone" name="Phone Number" required autocomplete="tel">
          </div>
        </div>

        <div class="field">
          <label for="service">Please briefly describe what type of service you are requesting <span class="req">*</span></label>
          <textarea id="service" name="Service Requested" required></textarea>
        </div>

        <div class="submit-row">
          <button class="btn btn-gold" type="submit">Submit</button>
          <span class="form-status" id="form-status"></span>
        </div>
      </form>
    </div>
  </section>

</main>

<footer>
  <div class="footer-bottom">
    <span>Five Stars Office Cleaning Service LLC &copy; 2026</span>
    <a href="index.html">Back to home</a>
  </div>
</footer>

<script>
  const form = document.getElementById('estimate-form');
  const status = document.getElementById('form-status');

  form.addEventListener('submit', async function(e) {
    e.preventDefault();

    // Honeypot check: if this hidden field has any value, it was filled by a bot.
    const honeypot = form.querySelector('input[name="_gotcha"]');
    if (honeypot && honeypot.value) {
      return; // Silently drop — no request sent, no error shown.
    }

    status.textContent = 'Sending...';
    status.className = 'form-status';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        form.reset();
        status.textContent = "Thanks! Your request has been sent. We'll get back to you shortly.";
        status.className = 'form-status success';
      } else {
        status.textContent = "Something went wrong. Please call us at 631-334-4943 or try again.";
        status.className = 'form-status error';
      }
    } catch (err) {
      status.textContent = "Something went wrong. Please call us at 631-334-4943 or try again.";
      status.className = 'form-status error';
    }
  });
</script>

</body>
</html>
